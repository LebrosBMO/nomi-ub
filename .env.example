# Server only. Never use EXPO_PUBLIC_ for the OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# low (default), minimal, medium, high, or none to leave it out.
OPENAI_REASONING_EFFORT=low
# Random token of at least 24 characters; enter it in app Settings.
NOMI_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8787
MAX_DAILY_AI_REQUESTS=200
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# Install keys and the report links of the business-owner side; at least 32 characters.
NOMI_SIGNING_SECRET=
# The business-owner side (/business, /admin). Supabase: the project URL and the service_role key (Project Settings →
# API). The service key bypasses Row Level Security, so it is server-only and never goes in an EXPO_PUBLIC_ variable.
# Without the two values dev keeps everything in memory and production answers 503. Tables: supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# What the founder types on /admin. Long and random.
NOMI_ADMIN_TOKEN=
