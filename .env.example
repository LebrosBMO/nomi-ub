# Server only. Never use EXPO_PUBLIC_ for the OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# low (default), minimal, medium, high, or none to leave it out.
OPENAI_REASONING_EFFORT=low
# Random token of at least 24 characters; enter it in app Settings.
NOMI_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8787
MAX_DAILY_AI_REQUESTS=200
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# Install keys and the report links of the business-owner side; at least 32 characters.
NOMI_SIGNING_SECRET=
# The business-owner side (/business, /admin). Without the two Upstash values dev keeps everything in memory and
# production answers 503; the admin token is what the founder types on /admin, so make it long and random.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NOMI_ADMIN_TOKEN=
