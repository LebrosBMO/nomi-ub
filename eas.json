{
  "cli": {
    "version": ">=16.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "ios-simulator": {
      "ios": {
        "simulator": true
      },
      "channel": "ios-simulator"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-business": {
      "extends": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "business"
      }
    },
    "production-business": {
      "extends": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "business"
      }
    }
  },
  "submit": {
    "production": {},
    "production-business": {}
  }
}
