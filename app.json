{
  "expo": {
    "name": "Nomi",
    "slug": "nomi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomi",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mn.nomi.pilot",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "mn.nomi.pilot",
      "adaptiveIcon": {
        "backgroundColor": "#164F43",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#164F43",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#164F43"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nomi ойролцоох газрыг олохын тулд байршлыг ашиглана.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5afdfb0a-1060-4fde-beb8-50bb4a1c9b7a"
      }
    },
    "owner": "tulgaluckystrikes-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5afdfb0a-1060-4fde-beb8-50bb4a1c9b7a"
    }
  }
}
